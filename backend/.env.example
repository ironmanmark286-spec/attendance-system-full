# Database
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=attendance_db
MYSQL_PORT=3306

# Auth (use a long random string - NEVER commit the real value)
JWT_SECRET=your-long-random-jwt-secret-here

# Razorpay - ONLY set these in server environment (Vercel/Railway/Render dashboard)
# NEVER put these in GitHub, frontend code, or .env files committed to git
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=5000
CORS_ORIGIN=http://localhost:3000
